    {
      "type": "timeseries",
      "title": "429 · 5xx",
      "description": "429 는 레이트 리밋의 판정이고 5xx 는 장애다. 둘을 한 판에 두는 이유는 레이트 리밋이 꺼진 동안(bypassed) 429 가 사라지고 5xx 가 오르는 모양을 한눈에 보려는 것이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "dawnline-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dawnline-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{service=\"order-service\", status=~\"429|5..\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 5,
      "gridPos": {
