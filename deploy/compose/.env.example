# =============================================================================
# Dawnline 로컬 스택 환경 변수 (deploy/compose/.env.example)
#
# 사용법:  cp deploy/compose/.env.example deploy/compose/.env
#          (또는 저장소 루트에서 `make env`)
#
# 규칙 (CLAUDE.md):
#   - 인프라 이미지 태그와 포트는 **이 파일에서만** 고정한다.
#     라이브러리 버전은 gradle/libs.versions.toml 에서만 고정한다.
#   - 실제 .env 는 커밋하지 않는다. .env.example 만 커밋한다.
#   - 여기 적힌 비밀번호는 전부 로컬 데모용 더미다. 운영에 쓰지 않는다.
#
# 이미지 태그는 2026-08-29 Docker Hub 에서 존재를 직접 확인했다.
# =============================================================================

# --- Compose 프로젝트 ---------------------------------------------------------
COMPOSE_PROJECT_NAME=dawnline

# --- 인프라 이미지 태그 -------------------------------------------------------
POSTGRES_IMAGE=postgres:18.2
KAFKA_IMAGE=apache/kafka:4.3.1
REDIS_IMAGE=redis:8.8.2
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
TEMPO_IMAGE=grafana/tempo:2.9.5
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.159.0

# --- 애플리케이션 이미지 ------------------------------------------------------
# `./gradlew bootBuildImage` (Buildpacks) 산출물의 태그.
# buildSrc 의 dawnline.spring-service 규약이 dawnline/<모듈명>:<version> 으로 만든다.
DAWNLINE_VERSION=0.1.0-SNAPSHOT

# --- 호스트 포트 --------------------------------------------------------------
# 컨테이너 내부에서는 모든 서비스가 8080 을 쓰고, 호스트 포트만 서로 다르다.
POSTGRES_PORT=5432
REDIS_PORT=6379
# 컨테이너 사이는 kafka:9092, 호스트 도구(kcat 등)는 localhost:29092 를 쓴다.
KAFKA_EXTERNAL_PORT=29092
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_HTTP_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

OPS_API_PORT=8080
ORDER_SERVICE_PORT=8081
FULFILLMENT_SERVICE_PORT=8082
DISPATCH_SERVICE_PORT=8083
TRACKING_SERVICE_PORT=8084

# --- PostgreSQL (DB-per-service, DESIGN.md §7.1) ------------------------------
# 슈퍼유저: initdb 스크립트 실행 및 운영자 psql 접속에만 쓴다.
POSTGRES_SUPERUSER=dawnline_admin
POSTGRES_SUPERUSER_PASSWORD=dawnline_admin_local
POSTGRES_DB=dawnline_admin

# 서비스별 전용 계정. 각 계정은 자기 DB 에만 CONNECT 권한을 가진다(교차 접근 물리 차단).
DAWNLINE_ORDER_DB_PASSWORD=order_local
DAWNLINE_FULFILLMENT_DB_PASSWORD=fulfillment_local
DAWNLINE_DISPATCH_DB_PASSWORD=dispatch_local
DAWNLINE_TRACKING_DB_PASSWORD=tracking_local
DAWNLINE_OPS_DB_PASSWORD=ops_local

# --- Kafka (DESIGN.md §7.3) ---------------------------------------------------
# 단일 노드 KRaft. CLUSTER_ID 는 base64 UUID 여야 한다:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=JTM9sUPRQ8uWrVKYkczK1Q
KAFKA_TOPIC_PARTITIONS=12
KAFKA_TOPIC_REPLICATION=1
# 일반 토픽 7일, DLQ 30일
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_DLQ_RETENTION_MS=2592000000
KAFKA_HEAP_OPTS="-Xms384m -Xmx512m"

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- 컨테이너 리소스 상한 -----------------------------------------------------
# Docker Desktop 메모리가 8GB 미만이면 `make up-lean`(관측성 스택 제외)을 쓴다.
# 권장: CPU 6 코어 이상, 메모리 12GB 이상 (deploy/compose/README.md 참고)
SERVICE_MEM_LIMIT=640m
SERVICE_CPU_LIMIT=0.75
# Paketo Buildpacks 이미지는 메모리 계산기가 -Xmx 를 자동 산정하지만,
# 명시적 -Xmx 가 있으면 그것을 존중한다. 결정론을 위해 직접 고정한다.
# 값에 공백이 있으므로 반드시 따옴표로 감싼다(Makefile 이 `. .env` 로 읽는다).
# Paketo 메모리 계산기가 컨테이너 상한 안에서 힙을 역산한다.
# -Xmx 를 직접 주면 계산기와 충돌하므로 주지 않는다. 대신 고정 영역을 줄여 준다:
#   기본값(코드캐시 240M + 스택 250개×1M)은 이 규모의 서비스에 과다하다.
#   고정 영역 = MaxDirectMemorySize(10M) + Metaspace(계산) + CodeCache + 스택×스레드수
SERVICE_JAVA_TOOL_OPTIONS="-XX:ReservedCodeCacheSize=128m -XX:+ExitOnOutOfMemoryError"
# 코어 서비스는 I/O 를 가상 스레드로 처리하므로 플랫폼 스레드는 250개까지 필요 없다.
SERVICE_JVM_THREAD_COUNT=50

# --- 관측성 ------------------------------------------------------------------
# Spring Boot 4.1 은 management.opentelemetry.map-environment-variables=true 가 기본이라
# 표준 OTEL_* 환경 변수를 그대로 인식한다(spring-boot-opentelemetry 4.1.1 메타데이터로 확인).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
