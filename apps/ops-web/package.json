{
  "name": "@dawnline/ops-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi/ops-api.yaml -o src/api/schema.ts",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "npm run generate",
    "test": "tsc --noEmit -p . && vitest run",
    "prebuild": "npm run generate",
    "build": "tsc --noEmit -p . && vite build",
    "predev": "npm run generate",
    "dev": "vite"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
