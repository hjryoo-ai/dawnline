{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawnline.internal/contracts/events/fulfillment.planned.v1.schema.json",
  "title": "fulfillment.planned v1 페이로드",
  "description": "FC·캠프·권역·웨이브 결정 결과 (DESIGN.md §4.3, §5.2). 토픽 dawnline.fulfillment.planned.v1, 키 orderId, 발행 fulfillment-service, 소비 dispatch-service·ops-api. 페이로드는 order.placed 스냅샷을 그대로 평면으로 포함한다 — dispatch-service 는 코어 서비스에 동기 조회를 할 수 없으므로(불변규칙 4) 계획에 필요한 값이 전부 이 이벤트 안에 있어야 한다.",
  "type": "object",
  "required": [
    "outcome",
    "orderId",
    "customerId",
    "serviceTier",
    "address",
    "promisedWindow",
    "parcel",
    "items",
    "placedAt"
  ],
  "additionalProperties": true,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["PLANNED", "UNSERVICEABLE"],
      "description": "계획 결과 (§5.2 6단계). UNSERVICEABLE 이면 배차 대상이 아니며 order-service 는 주문을 FAILED 로 전이하고 reason 을 기록한다."
    },
    "orderId": { "$ref": "#/$defs/uuid" },
    "customerId": { "$ref": "#/$defs/uuid" },
    "serviceTier": { "$ref": "#/$defs/serviceTier" },
    "address": { "$ref": "#/$defs/deliveryAddress" },
    "promisedWindow": { "$ref": "#/$defs/timeWindow" },
    "parcel": { "$ref": "#/$defs/parcel" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/orderItem" }
    },
    "placedAt": {
      "type": "string",
      "format": "date-time",
      "description": "order.placed 의 placedAt 을 그대로 옮긴 스냅샷 값. 계획 결정 시각은 봉투의 occurredAt 이므로 페이로드에 따로 두지 않는다."
    },
    "fcId": {
      "$ref": "#/$defs/uuid",
      "description": "선택된 풀필먼트 센터. outcome=PLANNED 일 때 필수."
    },
    "campId": {
      "$ref": "#/$defs/uuid",
      "description": "배송 캠프. 웨이브·계획의 병렬 단위다 (§4.5, §6.7). outcome=PLANNED 일 때 필수."
    },
    "zoneId": {
      "$ref": "#/$defs/uuid",
      "description": "주소 geohash5 로 매핑된 권역 (§5.2 4단계). outcome=PLANNED 일 때 필수."
    },
    "waveId": {
      "$ref": "#/$defs/uuid",
      "description": "편입된 웨이브. (campId, serviceTier, cutoffAt) 당 1개 (§5.2). outcome=PLANNED 일 때 필수."
    },
    "waveCutoffAt": {
      "type": "string",
      "format": "date-time",
      "description": "편입된 웨이브의 컷오프 시각. outcome=PLANNED 일 때 필수."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "UNSERVICEABLE 사유. order-service 가 주문 실패 사유로 기록한다 (§5.2 6단계). 권장 어휘는 README 참고. 값 집합이 아직 확정되지 않아 enum 대신 문자열로 둔다.",
      "examples": ["NO_FC_FOR_TIER", "NO_COLD_FC", "OUT_OF_STOCK", "NO_ZONE_MATCH", "NO_ACTIVE_CAMP"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "PLANNED" } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["fcId", "campId", "zoneId", "waveId", "waveCutoffAt"]
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "UNSERVICEABLE" } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["reason"]
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "serviceTier": {
      "type": "string",
      "enum": ["DAWN", "SAME_DAY", "NEXT_DAY"]
    },
    "geohash7": {
      "type": "string",
      "pattern": "^[0-9bcdefghjkmnpqrstuvwxyz]{7}$"
    },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "deliveryAddress": {
      "type": "object",
      "required": ["line", "postalCode", "lat", "lng", "geohash7"],
      "additionalProperties": true,
      "properties": {
        "line": { "type": "string", "minLength": 1, "maxLength": 500 },
        "postalCode": { "type": "string", "pattern": "^[0-9]{5}$" },
        "lat": { "$ref": "#/$defs/latitude" },
        "lng": { "$ref": "#/$defs/longitude" },
        "geohash7": { "$ref": "#/$defs/geohash7" }
      }
    },
    "timeWindow": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": true,
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "parcel": {
      "type": "object",
      "required": ["weightG", "volumeCm3", "requiresCold", "hazmat"],
      "additionalProperties": true,
      "properties": {
        "weightG": { "type": "integer", "minimum": 0 },
        "volumeCm3": { "type": "integer", "minimum": 0 },
        "requiresCold": { "type": "boolean" },
        "hazmat": { "type": "boolean" }
      }
    },
    "orderItem": {
      "type": "object",
      "required": ["sku", "qty"],
      "additionalProperties": true,
      "properties": {
        "sku": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9._-]+$" },
        "qty": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
